{
  "name": "social-to-chat",
  "version": "0.1.0",
  "description": "Self-hosted poller that watches Facebook, Instagram, LinkedIn and TikTok pages and posts new posts, comments and stats to a chat (Microsoft Teams via a webhook)",
  "main": "dist/src/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ && prettier --check src/ tests/",
    "format": "prettier --write src/ tests/",
    "start": "node dist/src/main.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "pino": "^10.3.1",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "license": "MIT"
}
