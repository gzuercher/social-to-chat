# social-to-chat — Secrets (kopieren nach .env, .env ist gitignored)

# Ziel-Webhook: Trigger-URL der social-feed Logic App (rendert die Teams-Karte).
WEBHOOK_URL=

# Plattform-Tokens (nur die aktiv genutzten befüllen).
LINKEDIN_ACCESS_TOKEN=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Optional
LOG_LEVEL=info
CONFIG_PATH=./config/platforms.yaml
