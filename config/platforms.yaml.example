# social-to-chat — Beispiel-Konfiguration
# Kopieren nach config/platforms.yaml und anpassen.
#
# SECRETS GEHÖREN HIER NICHT REIN. Tokens/URLs als ${ENV_NAME}-Platzhalter
# referenzieren; die Werte kommen aus Umgebungsvariablen (.env / Container-Env).
# Das Repo ist Open Source.

# Poll-Intervall (croner-Syntax). Default: alle 5 Minuten.
schedule: "*/5 * * * *"

# Ziel-Webhook. Besser via ENV WEBHOOK_URL setzen (hat Vorrang vor diesem Wert).
# Bei Raptus: Trigger-URL der Logic App `social-feed` (rendert die Teams-Karte).
webhookUrl: "${WEBHOOK_URL}"

# SQLite-Datei für Deduplizierung / State.
dbPath: "./data/social-to-chat.db"

platforms:
  # enabled setzt der Setup-Wizard beim Abschluss der Einrichtung — im
  # Template ist alles aus, damit das Config-Seeding im Container gefahrlos ist.
  - key: raptus-linkedin
    platform: linkedin
    name: "Raptus AG (LinkedIn)"
    enabled: false
    # OHNE Auto-Refresh: Ablaufdatum des Tokens pflegen (ISO-Datum), der
    # Poller warnt bei T-14/T-7/T-1 per Ops-Karte. MIT refresh-Block weglassen.
    # tokenExpiresAt: "2026-09-01"
    # Kommentare (Priorität 2) abschalten, wenn die Plattform sie nicht
    # freigibt — bei LinkedIn ohne Community-Management-Partnerfreigabe
    # antwortet der socialActions-Endpunkt mit 403. Posts laufen weiter.
    # comments: false
    options:
      organizationUrn: "urn:li:organization:XXXXXXXX"
      tokenEnv: "LINKEDIN_ACCESS_TOKEN"
      # Auto-Refresh (empfohlen): Poller erneuert den Access-Token selbst.
      # Einmaliger OAuth-Consent nötig — siehe docs/TOKENS.md.
      refresh:
        refreshTokenEnv: "LINKEDIN_REFRESH_TOKEN"
        clientIdEnv: "LINKEDIN_CLIENT_ID"
        clientSecretEnv: "LINKEDIN_CLIENT_SECRET"

  - key: raptus-facebook
    platform: facebook
    name: "Raptus AG (Facebook)"
    enabled: false
    options:
      pageId: "XXXXXXXXXXXX"
      tokenEnv: "FACEBOOK_PAGE_TOKEN"

  - key: raptus-instagram
    platform: instagram
    name: "Raptus AG (Instagram)"
    enabled: false
    options:
      # Voraussetzung: IG-Business-Konto, mit der FB-Page verknüpft.
      igUserId: "XXXXXXXXXXXX"
      tokenEnv: "INSTAGRAM_ACCESS_TOKEN"

  - key: raptus-tiktok
    platform: tiktok
    name: "Raptus AG (TikTok)"
    enabled: false
    options:
      # Achtung: Kommentare sind über TikTok nicht lesbar (nur Posts + Stats).
      # TikTok-Access-Tokens leben nur 24 h → der refresh-Block ist hier
      # PFLICHT für den Produktivbetrieb (clientIdEnv = client_key!).
      tokenEnv: "TIKTOK_ACCESS_TOKEN"
      refresh:
        refreshTokenEnv: "TIKTOK_REFRESH_TOKEN"
        clientIdEnv: "TIKTOK_CLIENT_KEY"
        clientSecretEnv: "TIKTOK_CLIENT_SECRET"
