# social-to-chat — Secrets (kopieren nach .env, .env ist gitignored)

# Ziel-Webhook: Trigger-URL der social-feed Logic App (rendert die Teams-Karte).
WEBHOOK_URL=

# Plattform-Tokens (nur die aktiv genutzten befüllen). Details: docs/TOKENS.md
LINKEDIN_ACCESS_TOKEN=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Token-Auto-Refresh (empfohlen; einmaliger OAuth-Consent, siehe docs/TOKENS.md).
# LinkedIn: Access 60 d, Refresh 365 d (Re-Consent jährlich, Ops-Karte warnt).
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# TikTok: Access 24 h, Refresh rotiert → ohne Refresh-Flow NICHT produktiv nutzbar.
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Facebook/Instagram: kein Refresh-Flow — System-User-Token nutzen (läuft nie ab).

# Optional
LOG_LEVEL=info
CONFIG_PATH=./config/platforms.yaml
# SQLite-State (Dedup/Health). Hat Vorrang vor dbPath in der YAML.
STATE_DB_PATH=./data/social-to-chat.db
